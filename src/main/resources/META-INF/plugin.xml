<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>uz.duke.plugin</id>
    <name>Duke Engine</name>
    <vendor url="https://www.sonic.uz">Sonic development team</vendor>

    <description><![CDATA[
        Editor support for the INI files that define content for Duke Engine, a deterministic Java RTS engine.
        <ul>
            <li>Highlighting for block headers, <code>End</code>, keys, values, numbers, strings and <code>;</code> comments</li>
            <li>Folding for <code>Object ... End</code> blocks and their module sub-blocks</li>
            <li>Structure view listing every block and the modules inside each <code>Object</code></li>
            <li>Checks for unclosed blocks, stray <code>End</code> lines and unrecognized lines</li>
            <li>Ctrl+Click from a block name used elsewhere, such as the hero a <code>DungeonSkill</code> belongs to, to its definition</li>
            <li>Module names and module fields completed and checked against the engine's <code>Module</code> classes
                on the project classpath; Ctrl+Click from a module name to its class</li>
            <li>A warning where <code>ModuleFactory.register</code> gives a module a name other than its class name,
                with a quick fix</li>
            <li>Asset paths (<code>Model = models/heroes/rogue.glb</code>, <code>Icon = skill_arrow_shot.png</code>)
                completed from the resource root, checked there with exact letter case, and opened by Ctrl+Click</li>
            <li>Duke Inspector tool window: the selected INI file as a form, with a checkbox, a list of files,
                block names or animation clips, or a text field for each field, modules added by group, and
                the blocks a unit is missing offered in one click</li>
            <li>File &gt; New &gt; Duke Unit: an empty unit or a renamed copy, added to the game's list of files</li>
        </ul>
        Block types and the fields of blocks other than modules are not checked.
        ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>

    <resource-bundle>messages.DukeBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <fileType name="Duke INI" language="DukeIni" extensions="ini"
                  implementationClass="uz.duke.plugin.ini.DukeIniFileType" fieldName="INSTANCE"/>
        <lang.parserDefinition language="DukeIni" implementationClass="uz.duke.plugin.ini.DukeIniParserDefinition"/>
        <lang.syntaxHighlighterFactory language="DukeIni"
                                       implementationClass="uz.duke.plugin.ini.DukeIniSyntaxHighlighterFactory"/>
        <lang.foldingBuilder language="DukeIni" implementationClass="uz.duke.plugin.ini.DukeIniFoldingBuilder"/>
        <lang.psiStructureViewFactory language="DukeIni"
                                      implementationClass="uz.duke.plugin.ini.DukeIniStructureViewFactory"/>
        <lang.findUsagesProvider language="DukeIni" implementationClass="uz.duke.plugin.ini.DukeIniFindUsagesProvider"/>
        <lang.elementManipulator forClass="uz.duke.plugin.ini.DukeIniModuleName"
                                 implementationClass="uz.duke.plugin.ini.DukeIniModuleNameManipulator"/>
        <annotator language="DukeIni" implementationClass="uz.duke.plugin.ini.DukeIniAnnotator"/>
        <annotator language="DukeIni" implementationClass="uz.duke.plugin.ini.DukeModuleAnnotator"/>
        <completion.contributor language="DukeIni"
                                implementationClass="uz.duke.plugin.ini.DukeModuleCompletionContributor"/>
        <annotator language="DukeIni" implementationClass="uz.duke.plugin.ini.DukeAssetAnnotator"/>
        <completion.contributor language="DukeIni"
                                implementationClass="uz.duke.plugin.ini.DukeAssetCompletionContributor"/>
        <typedHandler implementation="uz.duke.plugin.ini.DukeIniTypedHandler"/>
        <localInspection language="JAVA" shortName="DukeModuleRegistration"
                         bundle="messages.DukeBundle" key="inspection.registration.name" groupKey="inspection.group"
                         enabledByDefault="true" level="WARNING"
                         implementationClass="uz.duke.plugin.engine.DukeModuleRegistrationInspection"/>
        <toolWindow id="Duke Inspector" anchor="right" icon="AllIcons.Toolwindows.ToolWindowStructure"
                    factoryClass="uz.duke.plugin.inspector.DukeInspectorFactory"/>
    </extensions>

    <projectListeners>
        <listener class="uz.duke.plugin.inspector.DukeInspectorOpener"
                  topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
    </projectListeners>

    <actions>
        <action id="Duke.NewUnit" class="uz.duke.plugin.inspector.DukeNewUnitAction" text="Duke Unit…"
                description="Create a unit's INI file and add it to the game's list of files" icon="AllIcons.Nodes.Class">
            <add-to-group group-id="NewGroup" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
